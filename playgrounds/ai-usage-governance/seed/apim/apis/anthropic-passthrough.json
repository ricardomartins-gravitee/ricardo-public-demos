        "content": {
          "headers": false,
          "payload": false,
          "messageHeaders": false,
          "messagePayload": false,
          "messageMetadata": false
        }
      },
      "tracing": {"enabled": false}
    },
    "flowExecution": {"mode": "DEFAULT", "matchRequired": false},
    "flows": []
  },
  "plans": [
    {
      "definitionVersion": "V4",
      "id": "a1c0de00-0000-4000-8000-000000000013",
      "name": "Edge daemon",
      "description": "The Edge daemon on the device. The daemon does not authenticate to the gateway.",
      "security": {"type": "KEY_LESS", "configuration": {}},
      "mode": "STANDARD",
      "order": 1,
      "status": "PUBLISHED",
      "type": "API",
      "validation": "AUTO",
      "flows": []
    }
  ]
