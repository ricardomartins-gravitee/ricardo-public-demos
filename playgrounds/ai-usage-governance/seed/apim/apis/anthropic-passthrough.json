    "apiVersion": "1.0",
    "state": "STARTED",
    "visibility": "PRIVATE",
    "lifecycleState": "PUBLISHED",
    "labels": ["ai-usage-governance"],
    "tags": [],
    "categories": [],
    "listeners": [
      {
        "type": "HTTP",
        "paths": [{"path": "/interception/passthrough/", "overrideAccess": false}],
        "entrypoints": [{"type": "http-proxy", "qos": "AUTO", "configuration": {}}]
      }
    ],
    "endpointGroups": [
      {
        "name": "anthropic",
        "type": "http-proxy",
        "loadBalancer": {"type": "ROUND_ROBIN"},
        "endpoints": [
          {
            "name": "anthropic-api",
            "type": "http-proxy",
            "weight": 1,
            "inheritConfiguration": false,
            "configuration": {"target": "https://api.anthropic.com"}
          }
        ]
      }
    ],
    "analytics": {
      "enabled": true,
      "logging": {
        "mode": {"endpoint": false, "entrypoint": true},
