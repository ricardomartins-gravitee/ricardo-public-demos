{
  "openapi": "3.0.3",
  "info": {
    "title": "Shared Services API",
    "version": "1.0.0",
    "description": "Catalog of shared platform services and their current status."
  },
  "servers": [
    {
      "url": "http://localhost:8082/shared-services",
      "description": "Gravitee Gateway"
    },
    {
      "url": "http://localhost:8140",
      "description": "Shared Services API on this machine"
    }
  ],
  "paths": {
    "/v1/health": {
      "get": {
        "operationId": "health",
        "summary": "API health",
        "description": "Returns whether the Shared Services API is ready to serve catalog data.",
        "responses": {
          "200": {
            "description": "The API is healthy.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                },
                "example": {
                  "status": "ok"
                }
              }
            }
          }
        }
      }
    },
    "/v1/services": {
      "get": {
        "operationId": "listServices",
        "summary": "List shared services",
        "description": "Returns every shared platform service in catalog order with a total count.",
        "responses": {
          "200": {
            "description": "Catalog listing.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceListResponse"
                },
                "example": {
                  "count": 4,
                  "services": [
                    {
                      "id": "service-001",
                      "name": "Reporting Service",
                      "status": "operational",
                      "category": "shared-services",
                      "owner": "Platform Team",
                      "description": "Scheduled and on-demand operational reports."
                    },
                    {
                      "id": "service-002",
                      "name": "Notification Service",
                      "status": "operational",
                      "category": "shared-services",
                      "owner": "Platform Team",
                      "description": "Delivery of application notifications."
                    },
                    {
                      "id": "service-003",
                      "name": "Directory Service",
                      "status": "degraded",
                      "category": "shared-services",
                      "owner": "Platform Team",
                      "description": "Lookup of shared organizational units."
                    },
                    {
                      "id": "service-004",
                      "name": "Billing Service",
                      "status": "operational",
                      "category": "shared-services",
                      "owner": "Platform Team",
                      "description": "Usage records for shared platform services."
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v1/services/{id}": {
      "get": {
        "operationId": "getService",
        "summary": "Get a shared service",
        "description": "Returns one shared platform service by its catalog identifier.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Catalog identifier of the service.",
            "schema": {
              "type": "string"
            },
            "example": "service-001"
          }
        ],
        "responses": {
          "200": {
            "description": "The requested service.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Service"
                },
                "example": {
                  "id": "service-001",
                  "name": "Reporting Service",
                  "status": "operational",
                  "category": "shared-services",
                  "owner": "Platform Team",
                  "description": "Scheduled and on-demand operational reports."
                }
              }
            }
          },
          "404": {
            "description": "No service matches the identifier.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": "not_found",
                  "message": "No service has the id unknown."
                }
              }
            }
          }
        }
      }
    },
    "/v2/health": {
      "get": {
        "operationId": "healthV2",
        "summary": "API health for version 2.0",
        "responses": {
          "200": {
            "description": "The API is healthy.",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/HealthResponse"},
                "example": {"status": "ok"}
              }
            }
          }
        }
      }
    },
    "/v2/services": {
      "get": {
        "operationId": "listServicesV2",
        "summary": "List shared services, version 2.0",
        "description": "Version 2.0 of the catalog. Each service includes channel. Version 1.0 stays available.",
        "responses": {
          "200": {
            "description": "The catalog of shared services.",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/ServiceListResponse"},
                "example": {
                  "count": 1,
                  "services": [
                    {
                      "id": "service-001",
                      "name": "Reporting Service",
                      "status": "operational",
                      "category": "shared-services",
                      "owner": "Platform Team",
                      "description": "Scheduled and on-demand operational reports.",
                      "channel": "reports"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v2/services/{id}": {
      "get": {
        "operationId": "getServiceV2",
        "summary": "Get a shared service, version 2.0",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {"type": "string"},
            "example": "service-001"
          }
        ],
        "responses": {
          "200": {
            "description": "The requested service, including channel.",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/Service"},
                "example": {
                  "id": "service-001",
                  "name": "Reporting Service",
                  "status": "operational",
                  "category": "shared-services",
                  "owner": "Platform Team",
                  "description": "Scheduled and on-demand operational reports.",
                  "channel": "reports"
                }
              }
            }
          },
          "404": {
            "description": "No service matches the identifier.",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/ErrorResponse"},
                "example": {
                  "error": "not_found",
                  "message": "No service has the id unknown."
                }
              }
            }
          }
        }
      }
    },
    "/v1/notices": {
      "get": {
        "operationId": "listNotices",
        "summary": "List platform notices",
        "responses": {
          "200": {
            "description": "The operational notices.",
            "content": {
              "application/json": {
                "example": {
                  "count": 1,
                  "notices": [
                    {
                      "id": "notice-001",
                      "title": "Directory Service is degraded",
                      "status": "active",
                      "service": "service-003"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v1/notices/{id}": {
      "get": {
        "operationId": "getNotice",
        "summary": "Get one platform notice",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {"type": "string"},
            "example": "notice-001"
          }
        ],
        "responses": {
          "200": {
            "description": "The notice.",
            "content": {
              "application/json": {
                "example": {
                  "id": "notice-001",
                  "title": "Directory Service is degraded",
                  "status": "active",
                  "service": "service-003"
                }
              }
            }
          },
          "404": {
            "description": "No notice matches the identifier.",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/ErrorResponse"},
                "example": {
                  "error": "not_found",
                  "message": "No notice has the id unknown."
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          }
        }
      },
      "Service": {
        "type": "object",
        "required": [
          "id",
          "name",
          "status",
          "category",
          "owner",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "example": "service-001"
          },
          "name": {
            "type": "string",
            "example": "Reporting Service"
          },
          "status": {
            "type": "string",
            "enum": ["operational", "degraded"],
            "example": "operational"
          },
          "category": {
            "type": "string",
            "example": "shared-services"
          },
          "owner": {
            "type": "string",
            "example": "Platform Team"
          },
          "description": {
            "type": "string",
            "example": "Scheduled and on-demand operational reports."
          },
          "channel": {
            "type": "string",
            "description": "How a caller reaches the service. Present on version 2.0.",
            "example": "reports"
          }
        }
      },
      "ServiceListResponse": {
        "type": "object",
        "required": ["count", "services"],
        "properties": {
          "count": {
            "type": "integer",
            "minimum": 0,
            "example": 4
          },
          "services": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Service"
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["error", "message"],
        "properties": {
          "error": {
            "type": "string",
            "example": "not_found"
          },
          "message": {
            "type": "string",
            "example": "No service has the id unknown."
          }
        }
      }
    }
  }
}
